# SevAIQ Project Environment Configuration Example
# Copy this file to .env (or frontend/.env / backend/.env) for local overrides.
# NOTE: Never commit sensitive credentials or secret keys to version control.

# ==========================================
# Frontend Configuration (Vite / React)
# ==========================================
# Base URL for API calls to the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins for local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
